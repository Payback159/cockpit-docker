pkgname=cockpit-docker
pkgver=VERSION
pkgrel=1
pkgdesc='Cockpit module for Docker and Docker Compose'
arch=('x86_64')
url='https://github.com/Payback159/cockpit-docker'
license=(LGPL)
source=("SOURCE")
sha256sums=('SKIP')

package() {
  depends=(cockpit)
  cd $pkgname
  make DESTDIR="$pkgdir" install PREFIX=/usr
}
