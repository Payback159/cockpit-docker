#!/usr/bin/python3 -cimport os, sys; os.execv(os.path.dirname(sys.argv[1]) + "/common/pywrap", sys.argv)

# Run this with --help to see available options for tracing and debugging
# See https://github.com/cockpit-project/cockpit/blob/main/test/common/testlib.py
# "class Browser" and "class MachineCase" for the available API.

import testlib

# The tabs src/app.tsx renders unconditionally, in order. They are present
# whether or not Docker is installed; only their enabled state changes.
TABS = (
    "Overview",
    "Containers",
    "Compose Projects",
    "Images",
    "Volumes",
    "Port Mappings",
)


# Nondestructive: this module only reads (docker info, docker compose ls,
# docker ps), so it can share a VM with other tests.
@testlib.nondestructive
class TestApplication(testlib.MachineCase):
    def testBasic(self):
        b = self.browser
        m = self.machine

        self.login_and_go("/cockpit-docker")

        # Stage 1, invariant. This is the load-bearing assertion: the module
        # loads, React mounts, and the manifest is picked up. It holds on any
        # machine, with or without Docker.
        for tab in TABS:
            b.wait_in_text(".pf-v6-c-tabs__list", tab)

        # The menu label comes from src/manifest.json.
        b.switch_to_top()
        b.wait_text("#host-apps a[href='/cockpit-docker']", "Docker")
        b.go("/cockpit-docker")
        b.enter_page("/cockpit-docker")

        # Stage 2, state-dependent. Whether this machine has Docker is not
        # known in advance, so ask it rather than weaken the assertion to
        # "one of the two".
        if m.execute("command -v docker || true").strip():
            # DockerProvider settled on an access mode and checkSystem came
            # back; the Overview tab shows the daemon's own numbers.
            b.wait_in_text(".pf-v6-c-card__title", "Docker System Status")
        else:
            # probeAccess classified the failure as not-installed, so
            # DockerProvider raised it module-wide and the banner took over.
            # This also covers one of the five classified error kinds.
            b.wait_in_text(".pf-v6-c-alert__title", "Docker is not installed")


if __name__ == '__main__':
    testlib.test_main()
