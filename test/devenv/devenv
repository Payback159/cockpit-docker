#!/bin/sh
# Lebenszyklus der Test- und Entwicklungsumgebung.
#
#   up     Container starten (baut das Image bei Bedarf), Fixtures laden
#   down   Container UND beide Storage-Volumes entfernen
#   shell  Shell im Container oeffnen
#   reset  Fixtures zuruecksetzen, ohne neu zu bauen
set -eu

NAME=cockpit-docker-devenv
IMAGE=cockpit-docker-devenv
VOL_DOCKER=${NAME}-docker
VOL_CONTAINERD=${NAME}-containerd
PORT=${DEVENV_PORT:-19090}
SSH_PORT=${DEVENV_SSH_PORT:-12222}
WITH_SSH=0
BASE=ubuntu:26.04
DOCKER_SOURCE=distro

REPO_ROOT=$(cd "$(dirname "$0")/../.." && pwd)
HERE=$REPO_ROOT/test/devenv

usage() {
    echo "Aufruf: devenv {up|down|shell|reset|test} [--base IMAGE] [--source distro|docker.com] [--ssh]" >&2
    exit 2
}

cmd=${1:-}
[ -n "$cmd" ] || usage
shift || true

while [ $# -gt 0 ]; do
    case $1 in
        --base)   BASE=${2:?--base braucht ein Argument}; shift 2 ;;
        --source) DOCKER_SOURCE=${2:?--source braucht ein Argument}; shift 2 ;;
        --ssh)  WITH_SSH=1; shift ;;
        --)     shift; break ;;
        *)      break ;;
    esac
done

build() {
    docker build -q --build-arg "BASE=$BASE" --build-arg "DOCKER_SOURCE=$DOCKER_SOURCE" \
        -t "$IMAGE" -f "$HERE/Containerfile" "$HERE" >/dev/null
}

running() {
    docker ps --filter "name=^${NAME}$" --format '{{.Names}}' | grep -qx "$NAME"
}

wait_ready() {
    i=0
    while [ "$i" -lt 40 ]; do
        if docker exec "$NAME" systemctl is-active docker.service 2>/dev/null | grep -q '^active$'; then
            return 0
        fi
        sleep 1
        i=$((i + 1))
    done
    echo "docker.service im Container wurde nicht aktiv" >&2
    docker logs "$NAME" >&2 2>&1 || true
    return 1
}

case $cmd in
up)
    if running; then
        # --base/--source duerfen nicht stillschweigend ignoriert werden: sonst
        # misst man Ubuntu, waehrend man Debian angefordert hat.
        cur_base=$(docker inspect -f '{{index .Config.Labels "devenv.base"}}' "$NAME" 2>/dev/null || true)
        cur_source=$(docker inspect -f '{{index .Config.Labels "devenv.source"}}' "$NAME" 2>/dev/null || true)
        if [ -n "$cur_base" ] && \
           { [ "$cur_base" != "$BASE" ] || [ "$cur_source" != "$DOCKER_SOURCE" ]; }; then
            echo "Laeuft bereits mit --base $cur_base --source $cur_source," >&2
            echo "angefordert wurde --base $BASE --source $DOCKER_SOURCE." >&2
            echo "Erst 'devenv down', dann erneut starten." >&2
            exit 1
        fi
        echo "Laeuft bereits: http://127.0.0.1:$PORT"
        exit 0
    fi
    docker rm -f "$NAME" >/dev/null 2>&1 || true
    build
    # WICHTIG: keine --tmpfs- oder cgroup-Mounts (systemd stirbt sonst mit 255).
    # Zwei benannte Volumes, sonst overlay-auf-overlay beim Start von Containern.
    ssh_opt=""
    [ "$WITH_SSH" -eq 1 ] && ssh_opt="-p 127.0.0.1:$SSH_PORT:22"
    # shellcheck disable=SC2086
    docker run -d --name "$NAME" --privileged \
        --label "devenv.base=$BASE" --label "devenv.source=$DOCKER_SOURCE" \
        -p "127.0.0.1:$PORT:9090" $ssh_opt \
        -v "$VOL_DOCKER:/var/lib/docker" \
        -v "$VOL_CONTAINERD:/var/lib/containerd" \
        -v "$REPO_ROOT/dist:/usr/local/share/cockpit/cockpit-docker:ro" \
        -v "$REPO_ROOT/test/fixtures:/srv/fixtures:ro" \
        "$IMAGE" >/dev/null
    wait_ready
    if [ -x "$REPO_ROOT/test/fixtures/load.sh" ]; then
        docker exec "$NAME" /srv/fixtures/load.sh >/dev/null 2>&1 || \
            echo "Hinweis: Fixtures konnten nicht geladen werden" >&2
    fi
    echo "Bereit: http://127.0.0.1:$PORT   (devel/devel oder admin/admin)"
    ;;
down)
    docker rm -f "$NAME" >/dev/null 2>&1 || true
    docker volume rm "$VOL_DOCKER" "$VOL_CONTAINERD" >/dev/null 2>&1 || true
    echo "Entfernt: Container und beide Volumes"
    ;;
shell)
    running || { echo "Laeuft nicht - erst 'devenv up'" >&2; exit 1; }
    if [ $# -gt 0 ]; then
        docker exec "$NAME" sh "$@"
    else
        docker exec -it "$NAME" bash
    fi
    ;;
reset)
    running || { echo "Laeuft nicht - erst 'devenv up'" >&2; exit 1; }
    docker exec "$NAME" /srv/fixtures/load.sh --reset
    echo "Fixtures zurueckgesetzt"
    ;;
test)
    # Cockpits run-tests baut die Maschine ohne identity_file, also greift
    # machine.py auf DEFAULT_IDENTITY_FILE = bots/machine/identity zurueck und
    # meldet sich als root an. Genau dieser oeffentliche Schluessel muss also in
    # authorized_keys liegen -- ein selbst erzeugter Schluessel erreicht den
    # Runner nicht und endet in "Permission denied (publickey)".
    ID_PUB=$REPO_ROOT/bots/machine/identity.pub
    RUN_TESTS=$REPO_ROOT/test/common/run-tests
    # bots/ und test/common/ sind gitignored und werden nachgeladen.
    [ -f "$ID_PUB" ] || {
        echo "Fehlt: $ID_PUB" >&2
        echo "Cockpits bots sind nicht ausgecheckt - erst 'make bots' ausfuehren." >&2
        exit 1
    }
    [ -x "$RUN_TESTS" ] || {
        echo "Fehlt: $RUN_TESTS" >&2
        echo "Cockpits test/common ist nicht ausgecheckt - erst 'make test/common' ausfuehren." >&2
        exit 1
    }
    "$0" up --ssh --base "$BASE" --source "$DOCKER_SOURCE"
    docker port "$NAME" 22 >/dev/null 2>&1 || {
        echo "Container laeuft ohne SSH - erst 'devenv down', dann 'devenv test'" >&2
        exit 1
    }
    # Ueberschreiben statt anhaengen: mehrfache Laeufe sollen die Datei nicht
    # aufblaehen.
    docker exec -i "$NAME" sh -c \
        'mkdir -p /root/.ssh && chmod 700 /root/.ssh && cat > /root/.ssh/authorized_keys && chmod 600 /root/.ssh/authorized_keys' \
        < "$ID_PUB"
    sshp=$(docker port "$NAME" 22 | head -1 | cut -d: -f2)
    echo "run-tests gegen 127.0.0.1:$sshp (ssh, Schluessel bots/machine/identity)"
    echo "und 127.0.0.1:$PORT (web)"
    "$RUN_TESTS" \
        --machine "127.0.0.1:$sshp" \
        --browser "127.0.0.1:$PORT" \
        "$@"
    ;;
*)
    usage
    ;;
esac
