#!/bin/sh
# Ausführbare Prüfungen der Erfolgskriterien aus
# docs/superpowers/specs/2026-08-21-test-environment-design.md
set -eu

IMAGE=cockpit-docker-devenv
REPO_ROOT=$(cd "$(dirname "$0")/../.." && pwd)

pass() { printf '  ok    %s\n' "$1"; }
fail() { printf '  FAIL  %s\n' "$1"; FAILED=$((FAILED + 1)); }
check() {
    # check <Beschreibung> <Kommando...>
    desc=$1; shift
    if "$@" >/dev/null 2>&1; then pass "$desc"; else fail "$desc"; fi
}

verify_image() {
    echo "== Image =="
    FAILED=0
    c=devenv-verify-$$

    docker build -q -t "$IMAGE" -f "$REPO_ROOT/test/devenv/Containerfile" \
        "$REPO_ROOT/test/devenv" >/dev/null
    pass "Image baut"

    # Global Constraint: keine tmpfs-/cgroup-Handmounts, nur --privileged
    docker run -d --name "$c" --privileged "$IMAGE" >/dev/null
    trap 'docker rm -f "$c" >/dev/null 2>&1 || true' EXIT

    i=0
    while [ "$i" -lt 30 ]; do
        if docker exec "$c" systemctl is-active docker.service 2>/dev/null | grep -q '^active$'; then
            break
        fi
        sleep 2
        i=$((i + 1))
    done

    check "systemd laeuft"        docker exec "$c" systemctl is-system-running --wait
    check "cockpit.socket aktiv"  sh -c "docker exec $c systemctl is-active cockpit.socket | grep -q '^active$'"
    check "docker.service aktiv"  sh -c "docker exec $c systemctl is-active docker.service | grep -q '^active$'"
    check "eigener Daemon"        docker exec "$c" docker info
    check "compose v2 vorhanden"  sh -c "docker exec $c docker compose version | grep -qi 'v\\?2\\.\\|v\\?[3-9]\\.'"
    check "devel in Gruppe docker"     sh -c "docker exec $c id -nG devel | tr ' ' '\\n' | grep -qx docker"
    check "admin NICHT in docker"      sh -c "! docker exec $c id -nG admin | tr ' ' '\\n' | grep -qx docker"
    check "admin in Gruppe sudo"       sh -c "docker exec $c id -nG admin | tr ' ' '\\n' | grep -qx sudo"
    # Erfolgskriterium 3 der Spec: nicht nur Gruppenzugehoerigkeit, sondern
    # tatsaechliches Verhalten der beiden Zugriffslagen.
    check "devel erreicht Docker ohne Rechteerhoehung" \
        sh -c "docker exec -u devel $c docker ps -q"
    if docker exec -u admin "$c" docker ps -q >/dev/null 2>&1; then
        fail "admin erreicht Docker ohne sudo (muss scheitern)"
    else
        pass "admin scheitert ohne sudo (wie erwartet)"
        # Fehlertext protokollieren: beantwortet den offenen Punkt
        # "permission-denied-Muster" aus der Client-Spec.
        echo "  Muster: $(docker exec -u admin "$c" docker ps 2>&1 | head -1 | cut -c1-110)"
    fi
    check "admin erreicht Docker mit sudo" \
        sh -c "docker exec -u admin $c sh -c 'echo admin | sudo -S docker ps -q' 2>/dev/null"

    check "getty maskiert (kein degraded)" sh -c "docker exec $c systemctl is-enabled getty@tty1 2>&1 | grep -q masked"

    docker rm -f "$c" >/dev/null 2>&1 || true
    trap - EXIT
    [ "$FAILED" -eq 0 ] || return 1
}

verify_lifecycle() {
    echo "== Lebenszyklus =="
    FAILED=0
    DEVENV="$REPO_ROOT/test/devenv/devenv"
    PORT=${DEVENV_PORT:-19090}

    "$DEVENV" down >/dev/null 2>&1 || true

    "$DEVENV" up >/dev/null
    pass "up laeuft durch"

    check "Container laeuft" \
        sh -c "docker ps --filter name=cockpit-docker-devenv --format '{{.Names}}' | grep -qx cockpit-docker-devenv"
    check "Cockpit antwortet mit HTTP 200" \
        sh -c "curl -sf -o /dev/null -w '%{http_code}' http://127.0.0.1:$PORT/ | grep -qx 200"
    check "Port nur auf 127.0.0.1 gebunden" \
        sh -c "docker port cockpit-docker-devenv 9090 | grep -q '^127.0.0.1:'"
    check "Volume /var/lib/docker vorhanden" \
        sh -c "docker volume ls -q | grep -qx cockpit-docker-devenv-docker"
    check "Volume /var/lib/containerd vorhanden" \
        sh -c "docker volume ls -q | grep -qx cockpit-docker-devenv-containerd"

    # Inhaltliche Pruefung statt Zaehlung: nach `up` existiert auf dem Host
    # garantiert das Volume cockpit-docker-devenv-docker. Sieht der Container
    # es ebenfalls, teilt er den Daemon des Hosts -- dann ist die Isolation
    # verletzt. Diese Pruefung ist unabhaengig davon, wie viele Volumes es gibt.
    if docker exec cockpit-docker-devenv docker volume ls -q 2>/dev/null \
        | grep -qx cockpit-docker-devenv-docker; then
        fail "Isolation: Container sieht das Host-Volume cockpit-docker-devenv-docker"
    else
        pass "Isolation: Host-Volume im Container nicht sichtbar"
    fi

    check "up ist idempotent" "$DEVENV" up
    check "shell funktioniert"  sh -c "$DEVENV shell -c 'echo ok' | grep -qx ok"

    "$DEVENV" down >/dev/null
    check "down entfernt Container" \
        sh -c "! docker ps -a --format '{{.Names}}' | grep -qx cockpit-docker-devenv"
    check "down entfernt Volume docker" \
        sh -c "! docker volume ls -q | grep -qx cockpit-docker-devenv-docker"
    check "down entfernt Volume containerd" \
        sh -c "! docker volume ls -q | grep -qx cockpit-docker-devenv-containerd"

    [ "$FAILED" -eq 0 ] || return 1
}

verify_fixtures() {
    echo "== Fixtures =="
    FAILED=0
    DEVENV="$REPO_ROOT/test/devenv/devenv"
    dex() { docker exec cockpit-docker-devenv "$@"; }

    running=$(docker ps --filter "name=^cockpit-docker-devenv$" --format '{{.Names}}' || true)
    [ -n "$running" ] || "$DEVENV" up >/dev/null

    dex /srv/fixtures/load.sh >/dev/null
    pass "load.sh laeuft durch"

    for p in simple multifile stopped manyservices; do
        check "Projekt $p existiert" \
            sh -c "docker exec cockpit-docker-devenv docker compose ls --all --format json | grep -q '\"Name\":\"$p\"'"
    done

    # Kernfall: zwei kommagetrennte Pfade in ConfigFiles
    cfg=$(dex docker compose ls --all --format json | tr ',' '\n' | grep -c '/srv/fixtures/02-multifile/' || true)
    if [ "$cfg" -ge 2 ]; then
        pass "multifile liefert zwei Pfade in ConfigFiles"
    else
        fail "multifile liefert nur $cfg Pfad(e) in ConfigFiles"
    fi

    # Kernfall: mehrzeiliges NDJSON
    lines=$(dex sh -c 'cd /srv/fixtures/04-many-services && docker compose -p manyservices ps --format json' | wc -l)
    if [ "$lines" -ge 5 ]; then
        pass "manyservices liefert $lines NDJSON-Zeilen"
    else
        fail "manyservices liefert nur $lines Zeile(n), erwartet >= 5"
    fi

    check "stopped ist nicht running" \
        sh -c "! docker exec cockpit-docker-devenv docker compose ls --all --format json | grep -o '\"Name\":\"stopped\",\"Status\":\"[^\"]*\"' | grep -q running"
    check "Nicht-Compose-Container existiert" \
        sh -c "docker exec cockpit-docker-devenv docker ps -a --format '{{.Names}}' | grep -qx standalone"
    check "Nicht-Compose-Container hat kein Compose-Label" \
        sh -c "! docker exec cockpit-docker-devenv docker ps -a --filter label=com.docker.compose.project --format '{{.Names}}' | grep -qx standalone"
    check "verwaistes Volume existiert" \
        sh -c "docker exec cockpit-docker-devenv docker volume ls -q | grep -qx orphan-data"

    check "load.sh ist idempotent" dex /srv/fixtures/load.sh

    [ "$FAILED" -eq 0 ] || return 1
}

verify_mount() {
    echo "== Mount und Make-Targets =="
    FAILED=0
    DEVENV="$REPO_ROOT/test/devenv/devenv"

    running=$(docker ps --filter "name=^cockpit-docker-devenv$" --format '{{.Names}}' || true)
    [ -n "$running" ] || "$DEVENV" up >/dev/null

    check "Cockpit erkennt das Modul" \
        sh -c "docker exec -u devel cockpit-docker-devenv cockpit-bridge --packages | grep -q cockpit-docker"

    # Watch-Ablauf: eine Aenderung an dist/ muss im Container sofort sichtbar
    # sein, ohne Neustart.
    marker="devenv-mount-probe-$$"
    echo "$marker" > "$REPO_ROOT/dist/.devenv-probe"
    if docker exec cockpit-docker-devenv \
        grep -qx "$marker" /usr/local/share/cockpit/cockpit-docker/.devenv-probe 2>/dev/null; then
        pass "dist/ wirkt ohne Containerneustart"
    else
        fail "dist/ wirkt nicht ohne Containerneustart"
    fi
    rm -f "$REPO_ROOT/dist/.devenv-probe"

    check "Mount ist read-only" \
        sh -c "! docker exec cockpit-docker-devenv touch /usr/local/share/cockpit/cockpit-docker/.rw-probe 2>/dev/null"

    check "Make-Target devenv existiert"      sh -c "make -n devenv >/dev/null 2>&1"
    check "Make-Target devenv-stop existiert" sh -c "make -n devenv-stop >/dev/null 2>&1"

    [ "$FAILED" -eq 0 ] || return 1
}

verify_distros() {
    echo "== Distributionen =="
    FAILED=0
    c=devenv-distro-$$
    img=cockpit-docker-devenv-debian

    docker build -q --build-arg BASE=debian:13 -t "$img" \
        -f "$REPO_ROOT/test/devenv/Containerfile" "$REPO_ROOT/test/devenv" >/dev/null
    pass "Image baut auf debian:13"

    docker run -d --name "$c" --privileged \
        -v "${c}-docker:/var/lib/docker" \
        -v "${c}-containerd:/var/lib/containerd" \
        "$img" >/dev/null
    trap 'docker rm -f "$c" >/dev/null 2>&1 || true; docker volume rm "${c}-docker" "${c}-containerd" >/dev/null 2>&1 || true' EXIT

    i=0
    while [ "$i" -lt 40 ]; do
        docker exec "$c" systemctl is-active docker.service 2>/dev/null | grep -q '^active$' && break
        sleep 2
        i=$((i + 1))
    done

    check "cockpit.socket aktiv (debian)" \
        sh -c "docker exec $c systemctl is-active cockpit.socket | grep -q '^active$'"
    check "docker.service aktiv (debian)" \
        sh -c "docker exec $c systemctl is-active docker.service | grep -q '^active$'"
    check "compose v2 vorhanden (debian)" \
        sh -c "docker exec $c docker compose version >/dev/null"

    # Versionen protokollieren: sie beantworten offene Punkte der Client-Spec.
    echo "  Debian 13: $(docker exec "$c" docker --version 2>/dev/null || echo '?')"
    echo "             $(docker exec "$c" docker compose version 2>/dev/null || echo '?')"

    # Ausgabeformate auf dieser Version festhalten -- der tolerante Parser der
    # Client-Schicht muss beide Varianten vertragen.
    echo "  compose ls  beginnt mit: $(docker exec "$c" docker compose ls --format json 2>/dev/null | cut -c1-1)  ([ = Array)"

    # Zweite Quelle: nur bauen, nicht starten -- belegt, dass das Repo greift.
    if docker build -q --build-arg BASE=debian:13 --build-arg DOCKER_SOURCE=docker.com \
        -t "${img}-dockercom" -f "$REPO_ROOT/test/devenv/Containerfile" \
        "$REPO_ROOT/test/devenv" >/dev/null 2>&1; then
        pass "Image baut mit DOCKER_SOURCE=docker.com"
    else
        fail "Image baut nicht mit DOCKER_SOURCE=docker.com (Repo fuer diesen Codename vorhanden?)"
    fi

    docker rm -f "$c" >/dev/null 2>&1 || true
    docker volume rm "${c}-docker" "${c}-containerd" >/dev/null 2>&1 || true
    trap - EXIT
    [ "$FAILED" -eq 0 ] || return 1
}

case "${1:-all}" in
    image)     verify_image ;;
    lifecycle) verify_lifecycle ;;
    fixtures)  verify_fixtures ;;
    mount)     verify_mount ;;
    distros)   verify_distros ;;
    all)       verify_image && verify_lifecycle && verify_fixtures && verify_mount && verify_distros ;;
    *)         echo "Unbekannt: $1" >&2; exit 2 ;;
esac
echo "alle Pruefungen bestanden"
