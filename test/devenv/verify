#!/bin/sh
# Ausführbare Prüfungen der Erfolgskriterien aus
# docs/superpowers/specs/2026-08-21-test-environment-design.md
#
# ACHTUNG: destruktiv. Das Skript ruft `devenv down`, entfernt also Container
# UND beide Storage-Volumes, und hinterlaesst am Ende nichts Laufendes.
set -eu

IMAGE=cockpit-docker-devenv
DEBIAN_IMAGE=cockpit-docker-devenv-debian
REPO_ROOT=$(cd "$(dirname "$0")/../.." && pwd)

pass() { printf '  ok    %s\n' "$1"; }
fail() { printf '  FAIL  %s\n' "$1"; FAILED=$((FAILED + 1)); }
check() {
    # check <Beschreibung> <Kommando...>
    desc=$1; shift
    if "$@" >/dev/null 2>&1; then pass "$desc"; else fail "$desc"; fi
}
try() {
    # try <Beschreibung> <Kommando...>  -- wie check, aber fuer Kommandos,
    # auf denen die folgenden Pruefungen aufbauen: bei Fehlschlag wird der
    # Fehlertext gezeigt und ein Rueckgabewert != 0 geliefert, damit der
    # Aufrufer die Pruefgruppe abbrechen kann.
    #
    # Notwendig, weil `set -e` innerhalb von Funktionen, die in einer
    # ||-Verkettung stehen, nicht greift: ein ungeprueftes Kommando mit
    # anschliessendem `pass` waere eine Zusicherung, die nie fehlschlagen kann.
    desc=$1; shift
    if try_out=$("$@" 2>&1); then pass "$desc"; return 0; fi
    fail "$desc"
    printf '%s\n' "$try_out" | tail -10 | sed 's/^/        /'
    return 1
}

verify_image() {
    echo "== Image =="
    FAILED=0
    c=devenv-verify-$$

    try "Image baut" \
        docker build -q -t "$IMAGE" -f "$REPO_ROOT/test/devenv/Containerfile" \
        "$REPO_ROOT/test/devenv" || return 1

    # Global Constraint: keine tmpfs-/cgroup-Handmounts, nur --privileged
    trap 'docker rm -f "$c" >/dev/null 2>&1 || true' EXIT
    try "Container startet (--privileged, ohne Handmounts)" \
        docker run -d --name "$c" --privileged "$IMAGE" || { trap - EXIT; return 1; }

    i=0
    while [ "$i" -lt 30 ]; do
        if docker exec "$c" systemctl is-active docker.service 2>/dev/null | grep -q '^active$'; then
            break
        fi
        sleep 2
        i=$((i + 1))
    done

    check "systemd laeuft"        docker exec "$c" systemctl is-system-running --wait
    check "cockpit.socket aktiv"  sh -c "docker exec $c systemctl is-active cockpit.socket | grep -q '^active$'"
    check "docker.service aktiv"  sh -c "docker exec $c systemctl is-active docker.service | grep -q '^active$'"
    check "eigener Daemon"        docker exec "$c" docker info
    check "compose v2 vorhanden"  sh -c "docker exec $c docker compose version | grep -qi 'v\\?2\\.\\|v\\?[3-9]\\.'"
    check "devel in Gruppe docker"     sh -c "docker exec $c id -nG devel | tr ' ' '\\n' | grep -qx docker"
    check "admin NICHT in docker"      sh -c "! docker exec $c id -nG admin | tr ' ' '\\n' | grep -qx docker"
    check "admin in Gruppe sudo"       sh -c "docker exec $c id -nG admin | tr ' ' '\\n' | grep -qx sudo"
    # Erfolgskriterium 3 der Spec: nicht nur Gruppenzugehoerigkeit, sondern
    # tatsaechliches Verhalten der beiden Zugriffslagen.
    check "devel erreicht Docker ohne Rechteerhoehung" \
        sh -c "docker exec -u devel $c docker ps -q"
    if docker exec -u admin "$c" docker ps -q >/dev/null 2>&1; then
        fail "admin erreicht Docker ohne sudo (muss scheitern)"
    else
        pass "admin scheitert ohne sudo (wie erwartet)"
        # Fehlertext protokollieren: beantwortet den offenen Punkt
        # "permission-denied-Muster" aus der Client-Spec.
        echo "  Muster: $(docker exec -u admin "$c" docker ps 2>&1 | head -1 | cut -c1-110)"
    fi
    check "admin erreicht Docker mit sudo" \
        sh -c "docker exec -u admin $c sh -c 'echo admin | sudo -S docker ps -q' 2>/dev/null"

    check "getty maskiert (kein degraded)" sh -c "docker exec $c systemctl is-enabled getty@tty1 2>&1 | grep -q masked"

    docker rm -f "$c" >/dev/null 2>&1 || true
    trap - EXIT
    [ "$FAILED" -eq 0 ] || return 1
}

verify_lifecycle() {
    echo "== Lebenszyklus =="
    FAILED=0
    DEVENV="$REPO_ROOT/test/devenv/devenv"
    PORT=${DEVENV_PORT:-19090}

    "$DEVENV" down >/dev/null 2>&1 || true

    try "up laeuft durch" "$DEVENV" up || return 1

    check "Container laeuft" \
        sh -c "docker ps --filter name=cockpit-docker-devenv --format '{{.Names}}' | grep -qx cockpit-docker-devenv"
    check "Cockpit antwortet mit HTTP 200" \
        sh -c "curl -sf -o /dev/null -w '%{http_code}' http://127.0.0.1:$PORT/ | grep -qx 200"
    check "Port nur auf 127.0.0.1 gebunden" \
        sh -c "docker port cockpit-docker-devenv 9090 | grep -q '^127.0.0.1:'"
    check "Volume /var/lib/docker vorhanden" \
        sh -c "docker volume ls -q | grep -qx cockpit-docker-devenv-docker"
    check "Volume /var/lib/containerd vorhanden" \
        sh -c "docker volume ls -q | grep -qx cockpit-docker-devenv-containerd"

    # Inhaltliche Pruefung statt Zaehlung: nach `up` existiert auf dem Host
    # garantiert das Volume cockpit-docker-devenv-docker. Sieht der Container
    # es ebenfalls, teilt er den Daemon des Hosts -- dann ist die Isolation
    # verletzt. Diese Pruefung ist unabhaengig davon, wie viele Volumes es gibt.
    #
    # Die Ausgabe wird festgehalten, statt direkt in `grep` zu laufen: scheitert
    # `docker exec` selbst (Daemon noch nicht oben), ist stdout leer, `grep`
    # scheitert -- und der else-Zweig meldete faelschlich Isolation in Ordnung.
    if ! vols=$(docker exec cockpit-docker-devenv docker volume ls -q 2>&1); then
        fail "Isolation: 'docker volume ls' im Container schlug fehl - nicht bewertbar"
        printf '%s\n' "$vols" | tail -3 | sed 's/^/        /'
    elif printf '%s\n' "$vols" | grep -qx cockpit-docker-devenv-docker; then
        fail "Isolation: Container sieht das Host-Volume cockpit-docker-devenv-docker"
    else
        pass "Isolation: Host-Volume im Container nicht sichtbar"
    fi

    check "up ist idempotent" "$DEVENV" up
    check "shell funktioniert"  sh -c "$DEVENV shell -c 'echo ok' | grep -qx ok"

    "$DEVENV" down >/dev/null
    check "down entfernt Container" \
        sh -c "! docker ps -a --format '{{.Names}}' | grep -qx cockpit-docker-devenv"
    check "down entfernt Volume docker" \
        sh -c "! docker volume ls -q | grep -qx cockpit-docker-devenv-docker"
    check "down entfernt Volume containerd" \
        sh -c "! docker volume ls -q | grep -qx cockpit-docker-devenv-containerd"

    [ "$FAILED" -eq 0 ] || return 1
}

verify_fixtures() {
    echo "== Fixtures =="
    FAILED=0
    DEVENV="$REPO_ROOT/test/devenv/devenv"
    dex() { docker exec cockpit-docker-devenv "$@"; }

    running=$(docker ps --filter "name=^cockpit-docker-devenv$" --format '{{.Names}}' || true)
    [ -n "$running" ] || try "up fuer Fixtures" "$DEVENV" up || return 1

    try "load.sh laeuft durch" dex /srv/fixtures/load.sh || return 1

    for p in simple multifile stopped manyservices; do
        check "Projekt $p existiert" \
            sh -c "docker exec cockpit-docker-devenv docker compose ls --all --format json | grep -q '\"Name\":\"$p\"'"
    done

    # Kernfall: zwei kommagetrennte Pfade in ConfigFiles
    cfg=$(dex docker compose ls --all --format json | tr ',' '\n' | grep -c '/srv/fixtures/02-multifile/' || true)
    if [ "$cfg" -ge 2 ]; then
        pass "multifile liefert zwei Pfade in ConfigFiles"
    else
        fail "multifile liefert nur $cfg Pfad(e) in ConfigFiles"
    fi

    # Kernfall: mehrzeiliges NDJSON
    lines=$(dex sh -c 'cd /srv/fixtures/04-many-services && docker compose -p manyservices ps --format json' | wc -l)
    if [ "$lines" -ge 5 ]; then
        pass "manyservices liefert $lines NDJSON-Zeilen"
    else
        fail "manyservices liefert nur $lines Zeile(n), erwartet >= 5"
    fi

    check "stopped ist nicht running" \
        sh -c "! docker exec cockpit-docker-devenv docker compose ls --all --format json | grep -o '\"Name\":\"stopped\",\"Status\":\"[^\"]*\"' | grep -q running"
    check "Nicht-Compose-Container existiert" \
        sh -c "docker exec cockpit-docker-devenv docker ps -a --format '{{.Names}}' | grep -qx standalone"
    check "Nicht-Compose-Container hat kein Compose-Label" \
        sh -c "! docker exec cockpit-docker-devenv docker ps -a --filter label=com.docker.compose.project --format '{{.Names}}' | grep -qx standalone"
    check "verwaistes Volume existiert" \
        sh -c "docker exec cockpit-docker-devenv docker volume ls -q | grep -qx orphan-data"

    check "load.sh ist idempotent" dex /srv/fixtures/load.sh

    [ "$FAILED" -eq 0 ] || return 1
}

verify_mount() {
    echo "== Mount und Make-Targets =="
    FAILED=0
    DEVENV="$REPO_ROOT/test/devenv/devenv"

    running=$(docker ps --filter "name=^cockpit-docker-devenv$" --format '{{.Names}}' || true)
    [ -n "$running" ] || try "up fuer Mount-Pruefung" "$DEVENV" up || return 1

    check "Cockpit erkennt das Modul" \
        sh -c "docker exec -u devel cockpit-docker-devenv cockpit-bridge --packages | grep -q cockpit-docker"

    # Watch-Ablauf: eine Aenderung an dist/ muss im Container sofort sichtbar
    # sein, ohne Neustart.
    marker="devenv-mount-probe-$$"
    echo "$marker" > "$REPO_ROOT/dist/.devenv-probe"
    if docker exec cockpit-docker-devenv \
        grep -qx "$marker" /usr/local/share/cockpit/cockpit-docker/.devenv-probe 2>/dev/null; then
        pass "dist/ wirkt ohne Containerneustart"
    else
        fail "dist/ wirkt nicht ohne Containerneustart"
    fi
    rm -f "$REPO_ROOT/dist/.devenv-probe"

    check "Mount ist read-only" \
        sh -c "! docker exec cockpit-docker-devenv touch /usr/local/share/cockpit/cockpit-docker/.rw-probe 2>/dev/null"

    check "Make-Target devenv existiert"      sh -c "make -n devenv >/dev/null 2>&1"
    check "Make-Target devenv-stop existiert" sh -c "make -n devenv-stop >/dev/null 2>&1"

    [ "$FAILED" -eq 0 ] || return 1
}

verify_distros() {
    echo "== Distributionen =="
    FAILED=0
    c=devenv-distro-$$
    img=$DEBIAN_IMAGE

    # Die beiden Debian-Images (~1,5 GB) werden am Ende wieder entfernt --
    # verify soll nichts auf der Platte hinterlassen.
    distro_cleanup() {
        docker rm -f "$c" >/dev/null 2>&1 || true
        docker volume rm "${c}-docker" "${c}-containerd" >/dev/null 2>&1 || true
        docker image rm -f "$img" "${img}-dockercom" >/dev/null 2>&1 || true
    }

    trap 'distro_cleanup' EXIT
    try "Image baut auf debian:13" \
        docker build -q --build-arg BASE=debian:13 -t "$img" \
        -f "$REPO_ROOT/test/devenv/Containerfile" "$REPO_ROOT/test/devenv" \
        || { distro_cleanup; trap - EXIT; return 1; }

    try "Container startet auf debian:13" \
        docker run -d --name "$c" --privileged \
        -v "${c}-docker:/var/lib/docker" \
        -v "${c}-containerd:/var/lib/containerd" \
        -v "$REPO_ROOT/test/fixtures:/srv/fixtures:ro" \
        "$img" || { distro_cleanup; trap - EXIT; return 1; }

    i=0
    while [ "$i" -lt 40 ]; do
        docker exec "$c" systemctl is-active docker.service 2>/dev/null | grep -q '^active$' && break
        sleep 2
        i=$((i + 1))
    done

    check "cockpit.socket aktiv (debian)" \
        sh -c "docker exec $c systemctl is-active cockpit.socket | grep -q '^active$'"
    check "docker.service aktiv (debian)" \
        sh -c "docker exec $c systemctl is-active docker.service | grep -q '^active$'"
    # Gleicher Massstab wie auf Ubuntu: nicht nur "Kommando existiert", sondern
    # tatsaechlich eine Version >= 2.
    check "compose v2 vorhanden (debian)" \
        sh -c "docker exec $c docker compose version | grep -qi 'v\\?2\\.\\|v\\?[3-9]\\.'"

    # Versionen protokollieren: sie beantworten offene Punkte der Client-Spec.
    echo "  Debian 13: $(docker exec "$c" docker --version 2>/dev/null || echo '?')"
    echo "             $(docker exec "$c" docker compose version 2>/dev/null || echo '?')"

    # Ausgabeformate auf dieser Version festhalten -- der tolerante Parser der
    # Client-Schicht muss beide Varianten vertragen.
    echo "  compose ls  beginnt mit: $(docker exec "$c" docker compose ls --format json 2>/dev/null | cut -c1-1)  ([ = Array)"

    # `compose ps` ist der versionsempfindliche Fall, fuer den die Fixtures da
    # sind (NDJSON ab dem zweiten Service). Also auch auf Debian messen, nicht
    # nur `compose ls`.
    if docker exec "$c" sh -c \
        'cd /srv/fixtures/04-many-services && docker compose -p manyservices up -d' \
        >/dev/null 2>&1; then
        ps_json=$(docker exec "$c" sh -c \
            'cd /srv/fixtures/04-many-services && docker compose -p manyservices ps --format json' \
            2>/dev/null || true)
        echo "  compose ps  Zeilen: $(printf '%s\n' "$ps_json" | grep -c .), beginnt mit: $(printf '%s\n' "$ps_json" | head -1 | cut -c1-1)  ({ = NDJSON, [ = Array)"
    else
        echo "  compose ps  nicht messbar (Fixture liess sich nicht starten)"
    fi

    # Zweite Quelle: nur bauen, nicht starten -- belegt, dass das Repo greift.
    # Fehlertext sichtbar lassen: das ist der einzige sonst ungetestete Pfad.
    try "Image baut mit DOCKER_SOURCE=docker.com" \
        docker build -q --build-arg BASE=debian:13 --build-arg DOCKER_SOURCE=docker.com \
        -t "${img}-dockercom" -f "$REPO_ROOT/test/devenv/Containerfile" \
        "$REPO_ROOT/test/devenv" || true

    distro_cleanup
    trap - EXIT
    [ "$FAILED" -eq 0 ] || return 1
}

verify_testmode() {
    echo "== Betriebsart test =="
    FAILED=0
    DEVENV="$REPO_ROOT/test/devenv/devenv"
    ID="$REPO_ROOT/bots/machine/identity"

    if [ ! -f "${ID}.pub" ] || [ ! -x "$REPO_ROOT/test/common/run-tests" ]; then
        fail "bots/ oder test/common/ fehlt - erst 'make bots' und 'make test/common'"
        return 1
    fi

    # Eigene Kopie des Runner-Schluessels: ssh besteht auf 0600, und
    # bots/machine/identity soll dafuer nicht veraendert werden.
    key=$(mktemp "${TMPDIR:-/tmp}/devenv-verify-key.XXXXXX")
    trap 'rm -f "$key"' EXIT INT TERM
    cat "$ID" > "$key"
    chmod 600 "$key"

    "$DEVENV" down >/dev/null 2>&1 || true

    # Nicht nachbauen, sondern die Unterkommando `test` selbst aufrufen: sonst
    # bliebe diese Pruefung gruen, waehrend `devenv test` scheitert.
    # `--list` ist der billigste Aufruf; run-tests selbst laeuft auf diesem
    # Host nicht durch (Modul aiohttp fehlt) und die Suite ist ohnehin rot,
    # weil test/check-application noch aufs starter-kit zielt. Geprueft wird
    # daher der SSH-Handschlag, nicht ein gruener Lauf.
    testout=$("$DEVENV" test --list 2>&1) || true
    printf '%s\n' "$testout" | tail -4 | sed 's/^/        /'

    check "devenv test startet die Umgebung" \
        sh -c "docker ps --filter name=^cockpit-docker-devenv\$ --format '{{.Names}}' | grep -qx cockpit-docker-devenv"
    check "sshd laeuft im Container" \
        sh -c "docker exec cockpit-docker-devenv systemctl is-active ssh 2>/dev/null | grep -q '^active$' || docker exec cockpit-docker-devenv systemctl is-active sshd 2>/dev/null | grep -q '^active$'"
    check "SSH-Port gebunden" \
        sh -c "docker port cockpit-docker-devenv 22 | grep -q '^127.0.0.1:'"

    # Der Runner baut die Maschine ohne identity_file, machine.py faellt auf
    # bots/machine/identity zurueck und meldet sich als root an. Genau dieser
    # Schluessel muss also von `devenv test` hinterlegt worden sein.
    if ! authk=$(docker exec cockpit-docker-devenv cat /root/.ssh/authorized_keys 2>&1); then
        fail "devenv test hat keine authorized_keys hinterlegt"
        printf '%s\n' "$authk" | tail -3 | sed 's/^/        /'
    elif printf '%s\n' "$authk" | grep -qF "$(cut -d' ' -f2 < "${ID}.pub")"; then
        pass "devenv test hinterlegt bots/machine/identity.pub"
    else
        fail "authorized_keys enthaelt nicht bots/machine/identity.pub"
    fi

    port=$(docker port cockpit-docker-devenv 22 | head -1 | cut -d: -f2)
    if ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
           -o ConnectTimeout=10 -o BatchMode=yes -i "$key" -p "$port" root@127.0.0.1 \
           'echo verbunden' 2>/dev/null | grep -qx verbunden; then
        pass "SSH-Handschlag mit dem Schluessel des Runners (root@, bots/machine/identity)"
    else
        fail "SSH-Handschlag mit dem Schluessel des Runners scheitert"
    fi

    if printf '%s\n' "$testout" | grep -qi 'permission denied'; then
        fail "devenv test scheitert am SSH-Zugang (Permission denied)"
    else
        pass "devenv test scheitert nicht am SSH-Zugang"
    fi

    rm -f "$key"
    trap - EXIT INT TERM
    [ "$FAILED" -eq 0 ] || return 1
}

final_cleanup() {
    # verify soll nichts Laufendes hinterlassen -- weder einen privilegierten
    # Container mit veroeffentlichtem SSH-Port noch die Debian-Images.
    "$REPO_ROOT/test/devenv/devenv" down >/dev/null 2>&1 || true
    docker image rm -f "$DEBIAN_IMAGE" "${DEBIAN_IMAGE}-dockercom" >/dev/null 2>&1 || true
}

# Kein `a && b && c`: in einer solchen Verkettung ist `set -e` unterdrueckt,
# ein fehlgeschlagenes verify_image beendete das Skript also nicht und der
# Rueckgabewert war der des letzten Gliedes. Stattdessen ein Fehlerzaehler.
rc=0
case "${1:-all}" in
    image)     verify_image     || rc=1 ;;
    lifecycle) verify_lifecycle || rc=1 ;;
    fixtures)  verify_fixtures  || rc=1 ;;
    mount)     verify_mount     || rc=1 ;;
    distros)   verify_distros   || rc=1 ;;
    testmode)  verify_testmode  || rc=1 ;;
    all)
        for f in image lifecycle fixtures mount distros testmode; do
            "verify_$f" || rc=1
        done
        ;;
    *)         echo "Unbekannt: $1" >&2; exit 2 ;;
esac

final_cleanup

if [ "$rc" -eq 0 ]; then
    echo "alle Pruefungen bestanden"
else
    echo "Pruefungen fehlgeschlagen" >&2
fi
exit "$rc"
